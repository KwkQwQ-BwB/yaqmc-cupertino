{
  "manifestVersion": 1,
  "apiVersion": 4,
  "id": "dev.cupertino.yaqmc",
  "name": "Cupertino",
  "description": "An Apple-inspired redesign of the whole app: macOS on desktop, iOS on phones, iPadOS on tablets. Settings \u2192 Appearance \u2192 Material switches Classic (Opaque) and Liquid Glass (Translucent).",
  "version": "1.1.0",
  "license": "MIT",
  "engines": {
    "yaqmc": ">=0.1.1"
  },
  "homepage": "https://github.com/KwkQwQ-BwB/yaqmc-cupertino",
  "repository": "https://github.com/KwkQwQ-BwB/yaqmc-cupertino",
  "entrypoints": {
    "styles": [
      "styles/00-tokens.css",
      "styles/10-foundation.css",
      "styles/20-pages.css",
      "styles/30-now-playing.css",
      "styles/40-layout-pc.css",
      "styles/41-layout-phone.css",
      "styles/42-layout-pad.css",
      "styles/50-platform-ios.css",
      "styles/60-liquid-glass.css"
    ],
    "scenes": [
      "scenes/cupertino.scene.json"
    ]
  },
  "permissions": [
    "style.register",
    "scene.register"
  ]
}
